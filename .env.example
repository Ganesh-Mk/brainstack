# ═════════════════════════════════════════════════════════════════════════════
#  BrainStack — MASTER environment template
#
#  Copy this file to `.env` (gitignored) and paste real values as you create
#  each account. Phase 1 (the frontend) needs NONE of these — they exist so
#  every later backend phase can start without a setup detour.
#
#  ⚠ Set a hard spend limit on Anthropic + OpenAI before pasting keys.
# ═════════════════════════════════════════════════════════════════════════════

# ── Anthropic (Claude) — the LLM ─────────────────────────────────────────────
# console.anthropic.com → API keys. Used from Backend Phase 1 (rag_lab.py).
ANTHROPIC_API_KEY=

# ── OpenAI — embeddings for production ───────────────────────────────────────
# platform.openai.com. Dev uses the free local model (all-MiniLM-L6-v2),
# so this can wait until you want production-quality embeddings.
OPENAI_API_KEY=

# ── Pinecone — the vector database ───────────────────────────────────────────
# app.pinecone.io → API keys. One index ("brainstack"), namespace per tenant.
# Used from the end of Backend Phase 1.
PINECONE_API_KEY=
PINECONE_INDEX=brainstack

# ── Supabase — managed Postgres (metadata / users / tenants / traces) ────────
# supabase.com → Project Settings → Database → Connection string (URI).
# The FastAPI backend connects with DATABASE_URL via SQLAlchemy.
# (We use Supabase as Postgres only — auth stays custom FastAPI JWT.)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Auth (FastAPI JWT) — Backend Phase 0 ─────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Tavily — the agent's native web-search tool (Backend Phase 4) ────────────
# tavily.com → free tier API key.
TAVILY_API_KEY=

# ── LangSmith — tracing / observability (Backend Phase 7) ────────────────────
# smith.langchain.com. Two env vars switch tracing on.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=brainstack

# ── Redis — cache + job queue backend (local Docker in dev) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Model & cost discipline (defaults; override per environment) ─────────────
# Cheap in dev, swap up only for demos/production. See PROJECT_GUIDE.md §1.2.
LLM_MODEL_DEV=claude-haiku-4-5
LLM_MODEL_AGENT=claude-opus-4-8
LLM_MODEL_SYNTH=claude-sonnet-5
LLM_MODEL_JUDGE=claude-haiku-4-5
EMBEDDING_MODEL_DEV=all-MiniLM-L6-v2
EMBEDDING_MODEL_PROD=text-embedding-3-small
MAX_TOKENS_PER_REQUEST=4096

# ── Frontend (mirrors web/.env.example; set in Vercel, not here) ─────────────
NEXT_PUBLIC_ROOT_DOMAIN=brainstack.space
NEXT_PUBLIC_APP_DOMAIN=app.brainstack.space
NEXT_PUBLIC_API_URL=
