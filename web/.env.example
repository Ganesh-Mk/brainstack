# ─────────────────────────────────────────────────────────────────────────────
# BrainStack — frontend environment (Next.js)
# Copy to `.env.local` for local dev; set the same keys in Vercel → Settings →
# Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Domains used by proxy.ts for host-based routing (defaults match these).
NEXT_PUBLIC_ROOT_DOMAIN=brainstack.space
NEXT_PUBLIC_APP_DOMAIN=app.brainstack.space

# The FastAPI backend base URL. Empty until the backend phases deploy.
# e.g. https://api.brainstack.space
NEXT_PUBLIC_API_URL=
